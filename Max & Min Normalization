    import pandas as pd
    from sklearn.preprocessing import MinMaxScaler

    # Load the dataset
    file_path = r'C:\Users\superior\Downloads\data\01_tracks.csv'
    data = pd.read_csv(file_path)

    # Select numerical columns to normalize (excluding ID and categorical-like fields)
    columns_to_normalize = ['x', 'y', 'width', 'height', 'xVelocity', 'yVelocity', 
                            'xAcceleration', 'yAcceleration', 'precedingXVelocity']

    # Initialize MinMaxScaler
    scaler = MinMaxScaler()

    # Copy the original data to avoid overwriting it
    data_normalized = data.copy()

    # Apply Min-Max scaling
    data_normalized[columns_to_normalize] = scaler.fit_transform(data[columns_to_normalize])

    # Display the first few rows of the normalized data
    print(data_normalized.head())

    # Optional: Save the normalized data to a new CSV file
    data_normalized.to_csv(r'C:\Users\superior\Downloads\01_tracks_normalized.csv', index=False)
