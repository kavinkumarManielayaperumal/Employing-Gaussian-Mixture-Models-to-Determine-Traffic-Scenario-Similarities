import pandas as pd
from sklearn.preprocessing import MaxAbsScaler
import matplotlib.pyplot as plt
import seaborn as sns

# Load the dataset
file_path = r'C:\Users\superior\Downloads\data\01_tracks.csv'
data = pd.read_csv(file_path)

# Select numerical columns to normalize (excluding ID and categorical-like fields)
columns_to_normalize = ['xVelocity', 'yVelocity', 'xAcceleration', 'yAcceleration']

# Initialize MaxAbsScaler
scaler = MaxAbsScaler()

# Apply Max-Abs scaling and keep only the selected columns
data_maxabs_scaled = pd.DataFrame(scaler.fit_transform(data[columns_to_normalize]), columns=columns_to_normalize)

# Display the first few rows of the Max-Abs scaled data
print(data_maxabs_scaled.head())

# Optional: Save the Max-Abs scaled data to a new CSV file
data_maxabs_scaled.to_csv(r'C:\Users\superior\Downloads\01_tracks_maxabs_scaled.csv', index=False)

# Plot histograms for each of the scaled columns
plt.figure(figsize=(12, 8))
for i, column in enumerate(columns_to_normalize, 1):
    plt.subplot(2, 2, i)
    sns.histplot(data_maxabs_scaled[column], bins=30, kde=True)
    plt.title(f'Histogram of {column}')
    plt.xlabel(column)
    plt.ylabel('Frequency')

plt.tight_layout()
plt.show()
