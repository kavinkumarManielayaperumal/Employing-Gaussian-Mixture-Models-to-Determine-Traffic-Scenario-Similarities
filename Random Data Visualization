data=readtable('C:\Users\vinuk\Downloads\Environmental_Dataset_with_Clusters.csv');
features=data{:,1:end-1};
clusterIDs=data.ClusterID;
[coeff, score, ~] = pca(features);
reducedData = score(:, 1:2);
figure;
gscatter(reducedData(:,1), reducedData(:,2), clusterIDs);
title('PCA-Reduced Data with Original Clusters');
xlabel('Principal Component 1');
ylabel('Principal Component 2');
grid on;
numClusters = 3; % Number of clusters
gmmModel = fitgmdist(reducedData, numClusters);
predictedLabels = cluster(gmmModel, reducedData);
figure;
gscatter(reducedData(:,1), reducedData(:,2), predictedLabels);
title('GMM-Predicted Clusters');
xlabel('Principal Component 1');
ylabel('Principal Component 2');
grid on;
x = linspace(min(reducedData(:,1)), max(reducedData(:,1)), 100);
y = linspace(min(reducedData(:,2)), max(reducedData(:,2)), 100);
[X, Y] = meshgrid(x, y);
gridPoints = [X(:), Y(:)];
pdfValues = reshape(pdf(gmmModel, gridPoints), size(X));
figure;
gscatter(reducedData(:,1), reducedData(:,2), predictedLabels, [], [], 8);
hold on;
contour(X, Y, pdfValues, 20, 'LineWidth', 1.5);
title('GMM PDF Contours with Predicted Clusters');
xlabel('Principal Component 1');
ylabel('Principal Component 2');
grid on;
hold off;
silhouetteValues = silhouette(reducedData, predictedLabels);
avgSilhouette = mean(silhouetteValues);
disp(['Average Silhouette Score: ', num2str(avgSilhouette)]);
